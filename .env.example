# Local developer placeholders only. Never copy production credentials into this file.
# In Manus development/production, DATABASE_URL and MANUS_* platform values are injected.
DATABASE_URL=mysql://user:password@localhost:3306/pacearena
PORT=3000

# Preferred Gmail configuration. Use a Google App Password, not the regular account password.
# Hosted deployments should configure these in the protected project secret manager.
PACE_SMTP_USERNAME=your-account@gmail.com
PACE_SMTP_APP_PASSWORD=your-google-app-password
PACE_SMTP_FROM="Pace Arena <no-reply@example.com>"
# Generic SMTP URL fallback for other providers; used only if the Gmail pair is unset.
PACE_SMTP_URL=smtps://user:app-password@smtp.example.com:465
